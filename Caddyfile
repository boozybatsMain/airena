# TLS и один прокси. Больше здесь ничего быть не должно.
#
# Сертификат Caddy получает и продлевает сам — для этого нужны открытые 80 и
# 443 и A-запись домена на этот сервер, и ничего больше.
#
# WebSocket отдельной строки не требует: `reverse_proxy` в Caddy 2 пропускает
# Upgrade как есть. Это важнее, чем кажется, — вся трансляция боя идёт по
# сокету (`/ws`), и прокси, который его не пропускает, оставляет продукт
# формально живым и полностью немым.

{$AIRENA_DOMAIN} {
	encode zstd gzip

	# Заголовки источника едут наверх нетронутыми: сервер по ним решает, чужая
	# ли это страница (`crossSiteRefused`, `src/server/http.js`). Прокси,
	# переписывающий Host или теряющий Origin, отменил бы эту защиту тихо.
	reverse_proxy airena:8787 {
		header_up X-Forwarded-Proto {scheme}
	}
}
