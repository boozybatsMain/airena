# Переменные продакшен-стенда. Скопировать в `.env` рядом и заполнить.
#
# `.env` в репозиторий не попадает никогда (.gitignore). Этот файл — образец,
# и в нём нет ни одного настоящего значения.

# ── ОБЯЗАТЕЛЬНОЕ ─────────────────────────────────────────────────────────────

# Домен, на котором стоит сервер. Его же берёт Caddy для сертификата.
AIRENA_DOMAIN=airena.example.com

# Секрет подписи сессий. Без него (или короче 24 символов) продакшен не
# поднимается — и это правильно: подписывать сессии значением из исходников
# значит раздать всем возможность подделать любого игрока.
#   openssl rand -base64 48
AIRENA_SECRET=

# Ключ провайдера моделей. E4: всё идёт на собственном счёте, а не через
# кредитный канал GENEX. Без ключа генерация падает сразу с `no_key`, но
# сервер поднимается и витрину показывает.
OPENROUTER_API_KEY=

# ── ABILITY ICONS ────────────────────────────────────────────────────────────
#
# fal.ai key, used for one thing only: the three ability glyphs drawn per
# creature (`src/server/forge/icons.js`, model `fal-ai/flux/schnell`).
#
# OPTIONAL. Without it the server starts, creatures are born and fights run
# exactly as before — the icon endpoint simply answers 404 and the client draws
# its procedural fallback shapes instead. Nothing else reads this key.
#
# Get one at https://fal.ai/dashboard/keys, then backfill an existing stand:
#   node --env-file-if-exists=.env tools/seedicons.mjs --all
FAL_KEY=

# ── ЛИЧНОСТЬ ИГРОКА ──────────────────────────────────────────────────────────
#
# Личность даёт платформа: `embedToken`, подписанный её ключом. Подпись
# проверяется по-настоящему — `src/server/identity.js`, ключи берутся из
# открытого набора платформы, схема EdDSA на кривой Ed25519, штатным
# `node:crypto` без единой новой зависимости.
#
# КАКАЯ ИГРА — НАША. Это обязательно, и без этого сервер не поднимается.
# Токен выписан ДЛЯ ОДНОЙ игры (`slug` и `projectId` в претензиях). Проверить
# подпись и не сверить игру — значит принимать токен ЛЮБОЙ игры платформы:
# чужая игра выписывает своему игроку валидную подпись, тот приносит её сюда и
# заводит аккаунт у нас. Слаг подсматривается в `npx genex list`.
AIRENA_GENEX_SLUG=
#AIRENA_GENEX_PROJECT=

# Где лежат ключи платформы. Умолчание — её продакшен; переопределяется только
# для стенда.
#AIRENA_GENEX_JWKS=https://api.genex.games/api/auth/jwks

# Издатель токена. Пусто = не проверяем, и это записано честно: настоящего
# токена в руках не было, а выдавать дефолт из чужого кода за факт продакшена
# запрещает E8. Увидели живой токен — вписали сюда его `iss`.
#AIRENA_GENEX_ISS=

# Пускать ли сессии тестового канала. Замерено на живом превью: воркер
# платформы помечает превью как `channel: "staging"`, то есть НА ПРЕВЬЮ ВСЕ
# токены тестовые, и без этой переменной вход там не работает вовсе. На
# опубликованной игре не нужна и включать её незачем.
#AIRENA_ACCEPT_STAGING=1

# Аварийный режим, если платформа недоступна или слаг ещё не заведён: сервер
# поднимается витриной. Бои идут и смотреть можно, но аккаунт завести нельзя и
# генерация недоступна никому. Взаимоисключающе со строкой выше по смыслу:
# если слаг задан, этот режим не нужен.
#AIRENA_ALLOW_NO_IDENTITY=1

# ── ОТДЕЛЬНО СТОЯЩИЙ КЛИЕНТ ──────────────────────────────────────────────────
#
# Статику раздаёт GENEX, ручки живут здесь — значит источник у страницы чужой,
# и его надо назвать. Пусто = закрыто, и это умолчание.
#   AIRENA_CORS=https://<slug>.genex.technology
#   AIRENA_CORS=*     — любой источник; только для стенда
#
# У ПРЕВЬЮ ДРУГОЙ ХОСТ. `genex preview` раздаёт игру с
# `https://preview--<slug>.genex.technology`, а `genex publish` — с
# `https://<slug>.genex.technology`. Это РАЗНЫЕ источники, и разрешённый один
# не покрывает второй: перечисляй оба через запятую, пока пользуешься превью.
AIRENA_CORS=

# ── ШЕСТЬ ЛИМИТОВ E3 (src/server/limits.js) ──────────────────────────────────
#
# Умолчания в коде, здесь — то, что стоит подпереть на публичном сервере.
# Предохранитель GENEX при отказе ОТКРЫВАЕТСЯ; наш обязан закрываться.

# Дневной бюджет генерации на всю игру, USD.
AIRENA_DAILY_USD=25
# Сколько генераций идёт одновременно. Упирается в процессор, не в деньги.
AIRENA_MAX_CONCURRENT=4
# На аккаунт: в день и в месяц.
AIRENA_ACCT_DAY=3
AIRENA_ACCT_MONTH=20

# ── НЕОБЯЗАТЕЛЬНОЕ ───────────────────────────────────────────────────────────

# Служебные числа в `/api/health` и `/api/metrics`: сколько существ, матчей,
# что с циклом. Без этого наружу не отдаётся ничего, по чему видно бюджет.
#AIRENA_OPS=1

# Обрыв запроса к модели. Час — это «провайдер умер», а не «модель думает».
#AIRENA_WALL_MS=3600000

# Канал через локальный `claude` CLI. На чужом сервере его нет; включать
# нельзя — связки просто не сработают.
#AIRENA_SUB_MODELS=1

# ── Воркеры коллег: канал подписки на ЧУЖОЙ машине (D173) ────────────────────
#
# Кто допущен запускать воркер. Список через запятую: почта аккаунта или его id.
# ПУСТО = канал выключен целиком — умолчание выбрано так намеренно: забыть
# выставить список безопаснее, чем забыть его сузить.
#
# Здесь НЕТ и не будет переменной под токен Anthropic: учётные данные Claude не
# покидают машину коллеги, и хранить их нам прямо запрещено.
#AIRENA_WORKER_ACCOUNTS=gleb@example.com,masha@example.com
